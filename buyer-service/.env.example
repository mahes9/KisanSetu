# ── Application ──────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
PORT=8002

# ── Database ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/kisangpt_buyer

# ── Redis ────────────────────────────────
REDIS_URL=redis://localhost:6381/0

# ── JWT ──────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── External Services (Phase 1: mocked) ──
ENABLE_GSTIN_VERIFICATION=false
ENABLE_UPI_VERIFICATION=false
ENABLE_SELLER_SERVICE=false
GSTN_API_URL=https://api.gstn.example.com
GSTN_API_KEY=
SELLER_SERVICE_URL=http://localhost:8001

# ── Market Price Service ─────────────────
MARKET_PRICE_SERVICE_URL=http://localhost:8003
