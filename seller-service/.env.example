# ── Application ──────────────────────────────────────────
APP_NAME=seller-service
APP_VERSION=1.0.0
ENV=development
PORT=8001

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kisangpt_seller
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# ── Supabase Storage ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
STORAGE_BUCKET=kisangpt-listing-photos

# ── AI / LLM ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-20250514
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-1.5-flash

# ── Internal Services ───────────────────────────────────
PRICE_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007

# ── Razorpay ────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ── UIDAI (Aadhaar) ────────────────────────────────────
UIDAI_API_URL=https://uidai-api.example.com
UIDAI_API_KEY=your-uidai-api-key

# ── Feature Flags ───────────────────────────────────────
ENABLE_AI_GRADING=true
ENABLE_AADHAAR_VERIFICATION=false
ENABLE_BANK_VERIFICATION=false
ENABLE_REAL_PRICE_DATA=false
ENABLE_NOTIFICATIONS=false

# ── Phase 1 Scope ───────────────────────────────────────
PHASE1_CROPS=tomato,chilli_dry,chilli_green,groundnut
PHASE1_DISTRICTS=kurnool,nandyal

# ── Observability ───────────────────────────────────────
SENTRY_DSN=
